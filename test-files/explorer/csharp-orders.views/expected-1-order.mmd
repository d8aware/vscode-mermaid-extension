    Sku: string
    Price: Money
  }
  class Order {
    Lines: List&lt;Line&gt;
    Total: Money
    status: Status
    Add(Line) void
    IsPaid() bool
    MarkPaid() void
  }
  class Money {
    <<Shop>>
  }
  class Entity {
    <<Shop>>
  }
  class IStore {
    <<interface · Shop>>
  }
  class Service {
    <<Shop>>
  }
  class MemStore {
    <<Storage>>
  }
  Entity <|-- Order
  IStore ..> Order
  Line --> Money : Price
  MemStore ..> Order
  Order --> Line : Lines
  Order --> Money : Total
  Order --> Status : status
  Service ..> Order
