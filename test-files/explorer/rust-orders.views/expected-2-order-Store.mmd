classDiagram
  class Status {
    <<enumeration>>
    Open
    Paid
  }
  class Line {
    sku: String
    price: Money
  }
  class Order {
    id: String
    lines: Vec&lt;Line&gt;
    total: Money
    status: Status
    add(line) Result&lt;…, String&gt;
    is_paid() bool
    mark_paid()
    id() &amp;str
  }
  class Entity {
    <<interface · src/shop>>
  }
  class Money {
    <<src/shop>>
  }
  class Service {
    store: Box&lt;dyn Store&gt;
    new(store) Self
    checkout(order) Money
  }
  class Store {
    <<interface>>
    save(order)
    find(id) Option&lt;&amp;Order&gt;
  }
  class MemStore {
    <<src/storage>>
  }
  Entity <|.. Order
  Line --> Money : price
  MemStore ..> Order
  Order --> Line : lines
  Order --> Money : total
  Order --> Status : status
  Service --> Store : store
  Service ..> Order
  Store ..> Order
  Store <|.. MemStore
  style Status stroke:#e11d48,stroke-width:3px
  style Line stroke:#e11d48,stroke-width:3px
  style Order stroke:#e11d48,stroke-width:3px
  style Money fill:#f4f4f5,stroke:#a1a1aa,stroke-dasharray:4 3,color:#52525b
  style Entity fill:#f4f4f5,stroke:#a1a1aa,stroke-dasharray:4 3,color:#52525b
  style MemStore fill:#f4f4f5,stroke:#a1a1aa,stroke-dasharray:4 3,color:#52525b
