classDiagram
  class Order {
    $lines
    $total
    -$status
    add($line)
    isPaid()
    markPaid()
  }
  class Entity {
    <<src/Shop>>
  }
  class Line {
    <<src/Shop>>
  }
  class Money {
    <<src/Shop>>
  }
  class Status {
    <<enumeration · src/Shop>>
  }
  class Service {
    <<src/Shop>>
  }
  class Store {
    <<interface · src/Shop>>
  }
  class MemStore {
    <<src/Storage>>
  }
  Entity <|-- Order
  MemStore ..> Order
  Order --> Line : $lines
  Order --> Money : $total
  Order --> Status : $status
  Service ..> Order
  Store ..> Order
