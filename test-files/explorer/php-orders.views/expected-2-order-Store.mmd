classDiagram
  class Order {
    $lines
    $total
    -$status
    add($line)
    isPaid()
    markPaid()
  }
  class Entity {
    <<src/Shop>>
  }
  class Line {
    <<src/Shop>>
  }
  class Money {
    <<src/Shop>>
  }
  class Status {
    <<enumeration · src/Shop>>
  }
  class Service {
    -$store
    __construct($store)
    checkout($order)
  }
  class Store {
    <<interface>>
    save($order)
    find($id)
  }
  class MemStore {
    <<src/Storage>>
  }
  Entity <|-- Order
  MemStore ..> Order
  Order --> Line : $lines
  Order --> Money : $total
  Order --> Status : $status
  Service --> Store : $store
  Service ..> Order
  Store ..> Order
  Store <|.. MemStore
  style Order stroke:#e11d48,stroke-width:3px
  style Entity fill:#f4f4f5,stroke:#a1a1aa,stroke-dasharray:4 3,color:#52525b
  style Line fill:#f4f4f5,stroke:#a1a1aa,stroke-dasharray:4 3,color:#52525b
  style Money fill:#f4f4f5,stroke:#a1a1aa,stroke-dasharray:4 3,color:#52525b
  style Status fill:#f4f4f5,stroke:#a1a1aa,stroke-dasharray:4 3,color:#52525b
  style MemStore fill:#f4f4f5,stroke:#a1a1aa,stroke-dasharray:4 3,color:#52525b
