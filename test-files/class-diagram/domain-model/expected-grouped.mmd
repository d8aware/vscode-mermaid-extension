classDiagram
  namespace app {
    class UserRepository {
      <<interface>>
      +findAll() Promise&lt;User[]&gt;
    }
    class Logger {
      +log(message) void
    }
    class AppError {
    }
    class UserService {
      -repo: UserRepository
      +findAll() Promise&lt;User[]&gt;
    }
    class View {
      +render() string
    }
  }
  namespace domain {
    class Auditable {
      <<interface>>
      +createdAt: Date
    }
    class SoftDeletable {
      <<interface>>
      +deletedAt?: Date
    }
    class Entity["Entity&lt;TId&gt;"] {
      <<abstract>>
      +id: TId
      +validate() void*
      +equals(other) boolean
    }
    class OrderLine {
      <<type>>
      +product: string
      +quantity: number
      +price: Money
    }
    class Order {
      +lines: Map&lt;string, OrderLine[]&gt;
      +owner: Promise&lt;User&gt; | undefined
      +onChange: Function
      +meta: object
    }
    class Address {
      <<interface>>
      +street: string
      +city: string
    }
    class UserProps {
      <<interface>>
      +email: string
      +address?: Address
    }
    class User {
      +count: number$
      +createdAt: Date
      +balance: Money
      +orders: Order[]
      -props: UserProps
      -#secret: string
      +email: string
      +validate() void
      +updateAddress(street, city, ...tags) void
      +deposit(amount, note) Promise&lt;Money&gt;
      -recalculate() number
      #touch() void
    }
  }
  namespace dup.a {
    class Config {
      +host: string
    }
  }
  namespace dup.b {
    class Config_2["Config"] {
      +retries: number
    }
  }
  namespace shared {
    class Currency {
      <<enumeration>>
      USD
      EUR
    }
    class Money {
      +amount: number
      +currency: Currency
      +zero(currency) Money$
      +add(other) Money
    }
    class Helper {
      +help() void
    }
  }
  class Error
  Auditable <|-- SoftDeletable
  Auditable <|.. User
  Entity <|-- User
  Error <|-- AppError
  Money --> Currency : currency
  Order --> OrderLine : lines
  Order --> User : owner
  OrderLine --> Money : price
  User --> Money : balance
  User --> Order : orders
  User --> UserProps : props
  UserProps --> Address : address
  UserService --> UserRepository : repo
  UserService ..> Logger
