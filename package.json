{
  "name": "vscode-mermaid-extension",
  "displayName": "Mermaid MMD Tools",
  "description": "View Mermaid diagrams from .mmd and .mermaid files and generate class diagrams from TypeScript files.",
  "icon": "media/infinity-hatch-128.png",
  "version": "1.1.0",
  "publisher": "d8aware",
  "repository": {
    "type": "git",
    "url": "https://github.com/d8aware/vscode-mermaid-extension.git"
  },
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "mermaid",
    "diagram",
    "visualization",
    "uml",
    "class diagram",
    "typescript",
    "markdown"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/d8aware/vscode-mermaid-extension/issues"
  },
  "homepage": "https://github.com/d8aware/vscode-mermaid-extension#readme",
  "qna": "marketplace",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Mermaid MMD Tools",
      "properties": {
        "vscode-mermaid-extension.useSinglePreview": {
          "type": "boolean",
          "default": false,
          "description": "Use a single, shared preview panel that updates when switching between .mmd files (similar to Markdown preview behavior)"
        }
      }
    },
    "commands": [
      {
        "command": "vscode-mermaid-extension.showDiagramView",
        "icon": "$(circuit-board)",
        "shortTitle": "View Diagram",
        "title": "View Diagram"
      },
      {
        "command": "vscode-mermaid-extension.generateClassDiagram",
        "title": "Generate Class Diagram"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceExtname == .mmd || resourceExtname == .mermaid",
          "command": "vscode-mermaid-extension.showDiagramView",
          "title": "View Diagram",
          "group": "navigation@1"
        }
      ],
      "explorer/context": [
        {
          "command": "vscode-mermaid-extension.generateClassDiagram",
          "when": "explorerResourceIsFolder",
          "group": "1_open@9"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run compile && npm run webpack",
    "compile": "tsc -p ./",
    "webpack": "npx webpack",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test",
    "serve": "npm run build && npm run open",
    "open": "npx http-server dist -o /index.html?diagram=domain-driven-hexagon.mmd"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.0.1",
    "@types/vscode": "^1.107.0",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "copy-webpack-plugin": "^13.0.0",
    "eslint": "^9.39.2",
    "http-server": "^14.1.1",
    "ts-loader": "^9.5.2",
    "typescript": "^5.9.3",
    "webpack": "^5.103.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "dependencies": {
    "glob": "^13.0.0",
    "mermaid": "11.12.2",
    "ts-morph": "^27.0.2"
  }
}
