{
  "name": "vscode-mermaid-extension",
  "displayName": "Mermaid MMD Tools",
  "description": "Explore any codebase as diagrams, from projects down to classes, in TypeScript, Go, C#, PHP, Python, Java, Rust and more. Preview Mermaid .mmd files and generate class diagrams.",
  "icon": "media/infinity-hatch-128.png",
  "version": "3.1.1",
  "publisher": "d8aware",
  "repository": {
    "type": "git",
    "url": "https://github.com/d8aware/vscode-mermaid-extension.git"
  },
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "mermaid",
    "diagram",
    "visualization",
    "uml",
    "class diagram",
    "typescript",
    "markdown",
    "architecture",
    "code explorer",
    "dependency graph",
    "go",
    "csharp",
    "python",
    "java",
    "rust",
    "php"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/d8aware/vscode-mermaid-extension/issues"
  },
  "homepage": "https://github.com/d8aware/vscode-mermaid-extension#readme",
  "sponsor": {
    "url": "https://ko-fi.com/d8aware"
  },
  "qna": "marketplace",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Mermaid MMD Tools",
      "properties": {
        "vscode-mermaid-extension.useSinglePreview": {
          "type": "boolean",
          "default": false,
          "description": "Use a single, shared preview panel that updates when switching between .mmd files (similar to Markdown preview behavior)"
        },
        "vscode-mermaid-extension.diagramColors": {
          "type": "string",
          "enum": ["light", "editor"],
          "enumDescriptions": [
            "The diagrams' own colours on a light page (as saved and as shown on GitHub).",
            "The colours of your VS Code theme, light, dark or high contrast. A diagram that sets its own Mermaid theme keeps it; saved views keep their light colours."
          ],
          "default": "light",
          "description": "Colours of the diagram preview and the Code Explorer."
        },
        "vscode-mermaid-extension.classDiagram.explorerConsumers": {
          "type": "string",
          "enum": ["declared", "references"],
          "enumDescriptions": [
            "Consumers are classes that hold it in a field or receive it by constructor injection (our TypeScript analysis).",
            "Consumers are every class that references it, including method parameters and local use (asks the TypeScript language extension on each click)."
          ],
          "default": "declared",
          "description": "Explore Classes From Here on TypeScript files: which classes count as a class's consumers (the 'in' direction). Other languages always use every reference."
        },
        "vscode-mermaid-extension.classDiagram.includeTestFiles": {
          "type": "boolean",
          "default": false,
          "description": "Include test files (per language: *.spec.ts, *.test.ts, __tests__/, _test.go, test_*.py, *Test.java, …) in class diagrams and the code explorer."
        },
        "vscode-mermaid-extension.classDiagram.detail": {
          "type": "string",
          "enum": [
            "ask",
            "full",
            "public",
            "names"
          ],
          "enumDescriptions": [
            "All members for small folders; for large folders, ask",
            "All members",
            "Public members only (hide private and protected)",
            "Class names only (no members)"
          ],
          "default": "ask",
          "description": "Which members class diagrams show. In a focused diagram this applies to the neighbouring classes (\"ask\" means public members only); the focused file's classes are always shown in full."
        },
        "vscode-mermaid-extension.classDiagram.groupByFolder": {
          "type": "string",
          "enum": [
            "ask",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "Ask for large folders whose classes span several folders; otherwise don't group",
            "Always group classes by folder",
            "Never group"
          ],
          "default": "ask",
          "description": "Draw a box around the classes of each folder in a class diagram."
        },
        "vscode-mermaid-extension.classDiagram.largeFolderThreshold": {
          "type": "number",
          "default": 40,
          "minimum": 0,
          "description": "A folder with more classes, interfaces, enums and object types than this counts as large: when the detail or grouping setting is \"ask\", Generate Class Diagram asks how to show it."
        }
      }
    },
    "commands": [
      {
        "command": "vscode-mermaid-extension.showDiagramView",
        "icon": "$(circuit-board)",
        "shortTitle": "View Diagram",
        "title": "View Diagram"
      },
      {
        "command": "vscode-mermaid-extension.generateClassDiagram",
        "title": "Generate Class Diagram"
      },
      {
        "command": "vscode-mermaid-extension.generateFocusedClassDiagram",
        "title": "Generate Focused Class Diagram"
      },
      {
        "command": "vscode-mermaid-extension.exploreClasses",
        "title": "Explore Classes From Here"
      },
      {
        "command": "vscode-mermaid-extension.exploreFolder",
        "title": "Explore From Here"
      },
      {
        "command": "vscode-mermaid-extension.checkLanguageSupport",
        "category": "Mermaid",
        "title": "Check Explorer Language Support"
      },
      {
        "command": "vscode-mermaid-extension.recordExplorerAnswers",
        "category": "Mermaid (pack authors)",
        "title": "Record Explorer Answers"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceExtname == .mmd || resourceExtname == .mermaid",
          "command": "vscode-mermaid-extension.showDiagramView",
          "title": "View Diagram",
          "group": "navigation@1"
        }
      ],
      "explorer/context": [
        {
          "command": "vscode-mermaid-extension.exploreFolder",
          "when": "explorerResourceIsFolder",
          "group": "1_open@8"
        },
        {
          "command": "vscode-mermaid-extension.exploreClasses",
          "when": "resourceExtname =~ /^\\.(ts|tsx|mts|cts|go|cs|php|java|kt|py|rs|swift|rb|scala|dart|cpp|cc|cxx|hpp|h)$/ && !(resourceFilename =~ /\\.d\\.[cm]?ts$/)",
          "group": "1_open@8"
        },
        {
          "command": "vscode-mermaid-extension.generateClassDiagram",
          "when": "explorerResourceIsFolder",
          "group": "1_open@9"
        },
        {
          "command": "vscode-mermaid-extension.generateFocusedClassDiagram",
          "when": "resourceExtname =~ /^\\.(ts|tsx|mts|cts)$/ && !(resourceFilename =~ /\\.d\\.[cm]?ts$/)",
          "group": "1_open@9"
        }
      ],
      "editor/context": [
        {
          "command": "vscode-mermaid-extension.exploreClasses",
          "when": "resourceExtname =~ /^\\.(ts|tsx|mts|cts|go|cs|php|java|kt|py|rs|swift|rb|scala|dart|cpp|cc|cxx|hpp|h)$/ && !(resourceFilename =~ /\\.d\\.[cm]?ts$/)",
          "group": "1_modification@8"
        },
        {
          "command": "vscode-mermaid-extension.generateFocusedClassDiagram",
          "when": "resourceExtname =~ /^\\.(ts|tsx|mts|cts)$/ && !(resourceFilename =~ /\\.d\\.[cm]?ts$/)",
          "group": "1_modification@9"
        }
      ],
      "commandPalette": [
        {
          "command": "vscode-mermaid-extension.exploreClasses",
          "when": "resourceExtname =~ /^\\.(ts|tsx|mts|cts|go|cs|php|java|kt|py|rs|swift|rb|scala|dart|cpp|cc|cxx|hpp|h)$/ && !(resourceFilename =~ /\\.d\\.[cm]?ts$/)"
        },
        {
          "command": "vscode-mermaid-extension.generateClassDiagram",
          "when": "false"
        },
        {
          "command": "vscode-mermaid-extension.generateFocusedClassDiagram",
          "when": "resourceExtname =~ /^\\.(ts|tsx|mts|cts)$/ && !(resourceFilename =~ /\\.d\\.[cm]?ts$/)"
        },
        {
          "command": "vscode-mermaid-extension.exploreFolder",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "vscode-mermaid-extension.checkLanguageSupport",
          "when": "editorIsOpen"
        },
        {
          "command": "vscode-mermaid-extension.recordExplorerAnswers",
          "when": "workspaceFolderCount > 0"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run compile && npm run webpack",
    "compile": "tsc -p ./",
    "webpack": "npx webpack",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test",
    "test:webview": "node --test test-webview/explorer.test.mjs",
    "serve": "npm run build && npm run open",
    "open": "npx http-server dist -o /index.html?diagram=domain-driven-hexagon.mmd"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.107.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "copy-webpack-plugin": "^13.0.1",
    "eslint": "^10.15.0",
    "http-server": "^14.1.1",
    "playwright-core": "~1.58.0",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  },
  "dependencies": {
    "mermaid": "12.3.0",
    "ts-morph": "^28.0.0"
  }
}
